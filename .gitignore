# Build output is TRACKED in git so cPanel git deploys serve the
# prerendered HTML and hashed assets. Run `npm run build` locally before
# every commit to regenerate these files.
#   - /index.html                   (prerendered home)
#   - /assets/                      (hashed JS/CSS bundles)
#   - /about/, /contact/, /privacy-policy/, /marketing/, /development/, /products/
#     (per-route prerendered index.html files)
#
# `index.html.template` is the source-of-truth template that scripts/clean.mjs
# copies to index.html before each build.

